[sub_resource type="GDScript" id="GDScript_rkbax"]
script/source = "extends Node3D

@export_category(\"Input Actions\")
@export var action_swing_left : String = \"mouse_click_left\"
@export var action_swing_right : String = \"mouse_click_right\"

@export_category(\"Minecraft Bobbing & Sway\")
@export var sway_tilt_amount : float = 0.05
@export var max_tilt : float = 0.15
@export var smooth_speed : float = 8.0
@export var bob_freq : float = 5.0
@export var bob_amp_x : float = 0.015
@export var bob_amp_y : float = 0.012

@export_category(\"Swing Animation\")
@export var swing_speed : float = 6.0

@onready var initial_position : Vector3 = position
@onready var initial_rotation : Vector3 = rotation

# Tracking variables
var bob_time : float = 0.0
var mouse_input : Vector2 = Vector2.ZERO
var parent_character : CharacterBody3D

# Swing state variables
var is_swinging : bool = false
var swing_progress : float = 0.0

func _ready() -> void:
	# Safely fetch the Player node
	if get_owner() is CharacterBody3D:
		parent_character = get_owner()

func _unhandled_input(event: InputEvent) -> void:
	# 1. Capture Mouse Look for Sway
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		mouse_input = event.relative
		
	# 2. Trigger Swing on Configured Inputs (with safety checks)
	var left_pressed = InputMap.has_action(action_swing_left) and event.is_action_pressed(action_swing_left)
	var right_pressed = InputMap.has_action(action_swing_right) and event.is_action_pressed(action_swing_right)
	
	if left_pressed or right_pressed:
		if not is_swinging:
			is_swinging = true
			swing_progress = 0.0

func _process(delta: float) -> void:
	var target_pos : Vector3 = initial_position
	var target_rot : Vector3 = initial_rotation
	
	# --- 1. MINECRAFT SWAY & TILT (Camera lag) ---
	var tilt_x = clamp(-mouse_input.y * sway_tilt_amount, -max_tilt, max_tilt)
	var tilt_y = clamp(-mouse_input.x * sway_tilt_amount, -max_tilt, max_tilt)
	
	target_rot.x += tilt_x
	target_rot.y += tilt_y
	
	# Clear mouse input so it resets when the mouse stops moving
	mouse_input = Vector2.ZERO
	
	# --- 2. MINECRAFT BOBBING (Based on player movement) ---
	if parent_character:
		var vel = parent_character.velocity
		var is_on_floor = parent_character.is_on_floor()
		
		if is_on_floor and Vector2(vel.x, vel.z).length() > 0.1:
			bob_time += delta * bob_freq
			# Minecraft style distinct up-and-down rhythm
			target_pos.x += sin(bob_time) * bob_amp_x
			target_pos.y += abs(sin(bob_time * 1.5)) * bob_amp_y
		else:
			bob_time = lerp(bob_time, 0.0, delta * 5.0)
			
	# --- 3. EXACT MINECRAFT SWING MATH ---
	if is_swinging:
		swing_progress += delta * swing_speed
		if swing_progress >= 1.0:
			swing_progress = 0.0
			is_swinging = false
			
		# Treat progress as a 0 to PI radians curve
		var swing_angle = sin(swing_progress * PI)
		
		# Minecraft math: Hand dips down, forwards, and rotates inward sharply
		target_pos.x -= swing_angle * 0.05
		target_pos.y -= swing_angle * 0.08
		target_pos.z -= swing_angle * 0.05
		
		target_rot.x += swing_angle * 0.3
		target_rot.y -= swing_angle * 0.4
		target_rot.z -= swing_angle * 0.2
		
	# --- 4. APPLY TRANSFORM WITH SMOOTH LAG ---
	position = position.lerp(target_pos, delta * smooth_speed)
	rotation.x = lerp_angle(rotation.x, target_rot.x, delta * smooth_speed)
	rotation.y = lerp_angle(rotation.y, target_rot.y, delta * smooth_speed)
	rotation.z = lerp_angle(rotation.z, target_rot.z, delta * smooth_speed)
"

